{
    "name": "focus-tab-groups-obsidian",
    "version": "1.0.0",
    "description": "Focus Obsidian editor tab groups by number using configurable hotkeys.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
