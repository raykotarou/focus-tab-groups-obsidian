    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^26.2.0",
        "esbuild": "0.28.2",
        "eslint": "^10.9.0",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "obsidian": "latest",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0"
    }
}